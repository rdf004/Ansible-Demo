# Ubuntu 22.04 with systemd as PID 1, intended ONLY for local
# end-to-end testing of the Ansible deployment. Run with
# --privileged and the cgroup tmpfs mount in docker-compose.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    container=docker

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
        dbus \
        openssh-server \
        sudo \
        python3 \
        python3-apt \
        ca-certificates \
        iproute2 \
        procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Strip out unneeded systemd units to keep the container lean
RUN cd /lib/systemd/system/sysinit.target.wants/ && \
    ls | grep -v systemd-tmpfiles-setup | xargs rm -f && \
    rm -f /lib/systemd/system/multi-user.target.wants/*; \
    rm -f /etc/systemd/system/*.wants/*; \
    rm -f /lib/systemd/system/local-fs.target.wants/*; \
    rm -f /lib/systemd/system/sockets.target.wants/*udev*; \
    rm -f /lib/systemd/system/sockets.target.wants/*initctl*; \
    rm -f /lib/systemd/system/basic.target.wants/*; \
    rm -f /lib/systemd/system/anaconda.target.wants/*

# SSH setup mirroring the original target
RUN mkdir -p /run/sshd && \
    echo 'root:devin' | chpasswd && \
    sed -i \
        's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' \
        /etc/ssh/sshd_config && \
    sed -i \
        's/#PasswordAuthentication yes/PasswordAuthentication yes/' \
        /etc/ssh/sshd_config && \
    systemctl enable ssh

EXPOSE 22 80 443

STOPSIGNAL SIGRTMIN+3

# Boot into systemd so role tasks like `systemctl start
# tradeops-backend` actually work.
CMD ["/sbin/init"]
