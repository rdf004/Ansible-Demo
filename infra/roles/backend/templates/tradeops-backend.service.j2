# Ansible managed — TradeOps Backend Service
[Unit]
Description=TradeOps Backend (Gunicorn)
After=network.target
Wants=network.target

[Service]
Type=notify
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_current_link }}/backend
ExecStart={{ app_current_link }}/backend/venv/bin/gunicorn \
    --config {{ app_current_link }}/backend/gunicorn.conf.py \
    wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=append:{{ app_log_dir }}/backend.log
StandardError=append:{{ app_log_dir }}/backend-error.log

# Health check — restart if unhealthy
WatchdogSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ app_log_dir }} {{ app_data_dir }}

[Install]
WantedBy=multi-user.target
