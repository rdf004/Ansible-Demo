# Ansible managed — Gunicorn configuration
bind = "{{ backend_bind }}"
workers = {{ gunicorn_workers }}
timeout = {{ gunicorn_timeout }}
graceful_timeout = {{ gunicorn_graceful_timeout }}
max_requests = {{ gunicorn_max_requests }}
max_requests_jitter = {{ gunicorn_max_requests_jitter }}
loglevel = "{{ gunicorn_log_level | default('info') }}"

# Logging
accesslog = "{{ app_log_dir }}/gunicorn-access.log"
errorlog = "{{ app_log_dir }}/gunicorn-error.log"
# Structured JSON access log — keeps each line trivially
# parseable by jq, Loki, ES, etc. without a custom grok pattern.
access_log_format = (
    '{"remote":"%(h)s","time":"%(t)s",'
    '"request":"%(r)s","status":%(s)s,'
    '"bytes":"%(b)s","referrer":"%(f)s",'
    '"user_agent":"%(a)s","duration_us":%(D)s}'
)

# Process naming
proc_name = "tradeops-backend"

# Preload app for faster worker spawning
preload_app = True
