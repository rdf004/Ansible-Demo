#!/bin/bash
# Ansible managed — TradeOps Backup Script
set -euo pipefail

BACKUP_DIR="{{ app_backup_dir }}"
APP_BASE="{{ app_base_dir }}"
APP_CURRENT="{{ app_current_link }}"
SHARED_REL="$(basename {{ app_shared_dir }})"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
DAY_OF_WEEK=$(date +%u)
BACKUP_FILE="${BACKUP_DIR}/tradeops_daily_${TIMESTAMP}.tar.gz"

# Resolve the release the symlink points at so tar archives
# the actual release directory contents, not the symlink. Both
# the release path and the shared path are then expressed
# relative to APP_BASE so a single -C anchors them, and tar
# stores clean relative paths in the archive (no /opt/tradeops
# leakage).
RELEASE_DIR="$(readlink -f "${APP_CURRENT}")"
RELEASE_REL="releases/$(basename "${RELEASE_DIR}")"

tar -czf "${BACKUP_FILE}" \
    -C "${APP_BASE}" \
    --exclude='*/venv/*' \
    --exclude='*/node_modules/*' \
    "${RELEASE_REL}" \
    "${SHARED_REL}"

chmod 640 "${BACKUP_FILE}"
chown {{ app_user }}:{{ app_group }} "${BACKUP_FILE}"

# Weekly backup (on Sunday)
if [ "${DAY_OF_WEEK}" -eq 7 ]; then
    cp "${BACKUP_FILE}" \
       "${BACKUP_DIR}/tradeops_weekly_${TIMESTAMP}.tar.gz"
fi

# Rotate daily backups — keep {{ backup_daily_keep }}
ls -t ${BACKUP_DIR}/tradeops_daily_*.tar.gz 2>/dev/null \
    | tail -n +$(( {{ backup_daily_keep }} + 1 )) \
    | xargs -r rm -f

# Rotate weekly backups — keep {{ backup_weekly_keep }}
ls -t ${BACKUP_DIR}/tradeops_weekly_*.tar.gz 2>/dev/null \
    | tail -n +$(( {{ backup_weekly_keep }} + 1 )) \
    | xargs -r rm -f

echo "Backup completed: ${BACKUP_FILE}"
