{{ app_log_dir }}/*.log {
    daily
    missingok
    rotate {{ log_retention_days }}
    compress
    delaycompress
    notifempty
    create 0640 {{ app_user }} {{ app_group }}
    sharedscripts
    postrotate
        systemctl reload nginx > /dev/null 2>&1 || true
        systemctl kill -s USR1 tradeops-backend > /dev/null 2>&1 || true
    endscript
}
